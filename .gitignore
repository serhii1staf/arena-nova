# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Tauri native build artifacts
src-tauri/target/
src-tauri/gen/

# Local state from `wrangler dev`
.wrangler/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
Thumbs.db

# Logs
*.log
npm-debug.log*

# Signing keys — NEVER commit these
*.key
*.key.pub
.arena-nova-keys/

# Smoke-test artefacts
scripts/*.png

# Authored character models are user-supplied (see public/models/README.md).
# Licences vary per asset, so they are never committed — except the one the game
# ships with, which is CC0 and credited in CREDITS.md.
public/models/*.glb
!public/models/character.glb

# Asset packs downloaded for conversion; only the converted GLB is kept.
*.zip
public/models/*.gltf
public/models/*.bin
public/models/*.fbx

# Loose source drops in the repo root. Assets that ship live under public/.
/*.gif
